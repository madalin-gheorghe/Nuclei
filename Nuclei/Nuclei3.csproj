<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net48;net7.0-windows</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<OutputType>Library</OutputType>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<UseWindowsForms>true</UseWindowsForms>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		
		<AssemblyName>Nuclei4</AssemblyName>
		<RootNamespace>Nuclei3</RootNamespace>

		<TargetExt>.gha</TargetExt>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AssemblyIcon>Nuclei.ico</AssemblyIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grasshopper" Version="8.0.*" />
		<PackageReference Include="RhinoCommon" Version="8.0.*" />
		<PackageReference Include="System.Resources.Extensions" Version="4.7.1" />
		<PackageReference Include="Vortice.D3DCompiler" Version="2.4.1-beta" />
		<PackageReference Include="Vortice.Direct3D11" Version="2.4.1-beta" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\MoveParticlesAndDeposit.cso" LogicalName="Nuclei3.GpuShaders.MoveParticlesAndDeposit.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\ApplyDeposits.cso" LogicalName="Nuclei3.GpuShaders.ApplyDeposits.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\ClearParticleCounts.cso" LogicalName="Nuclei3.GpuShaders.ClearParticleCounts.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\CountParticles.cso" LogicalName="Nuclei3.GpuShaders.CountParticles.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\SeedNeighbourCounts.cso" LogicalName="Nuclei3.GpuShaders.SeedNeighbourCounts.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\SumNeighbourAxis.cso" LogicalName="Nuclei3.GpuShaders.SumNeighbourAxis.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\ApplyParticleDeath.cso" LogicalName="Nuclei3.GpuShaders.ApplyParticleDeath.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\ApplyParticleDivision.cso" LogicalName="Nuclei3.GpuShaders.ApplyParticleDivision.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DiffuseAxis.cso" LogicalName="Nuclei3.GpuShaders.DiffuseAxis.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\ApplyDecay.cso" LogicalName="Nuclei3.GpuShaders.ApplyDecay.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\BuildDensityPreview.cso" LogicalName="Nuclei3.GpuShaders.BuildDensityPreview.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\BuildCombinedDensityPreview.cso" LogicalName="Nuclei3.GpuShaders.BuildCombinedDensityPreview.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\BuildDensityGradientPreview.cso" LogicalName="Nuclei3.GpuShaders.BuildDensityGradientPreview.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\BuildParticlePreview.cso" LogicalName="Nuclei3.GpuShaders.BuildParticlePreview.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\BuildParticleTrailPreview.cso" LogicalName="Nuclei3.GpuShaders.BuildParticleTrailPreview.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewVS.cso" LogicalName="Nuclei3.GpuShaders.DensityPreviewVS.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewPS.cso" LogicalName="Nuclei3.GpuShaders.DensityPreviewPS.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewOccupancy.cso" LogicalName="Nuclei3.GpuShaders.DensityPreviewOccupancy.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewShadow.cso" LogicalName="Nuclei3.GpuShaders.DensityPreviewShadow.cso" />
		<EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewComposite.cso" LogicalName="Nuclei3.GpuShaders.DensityPreviewComposite.cso" />
	</ItemGroup>

	<Target Name="CompileGpuShaders" BeforeTargets="PrepareResources"
		Inputs="$(MSBuildProjectDirectory)\GpuFullSlimeSolverEngine.cs;$(MSBuildProjectDirectory)\GpuDensityFieldD3DRenderer.cs;$(MSBuildProjectDirectory)\..\tools\Nuclei.ShaderCompiler\Program.cs;$(MSBuildProjectDirectory)\..\tools\Nuclei.ShaderCompiler\Nuclei.ShaderCompiler.csproj"
		Outputs="$(IntermediateOutputPath)GpuShaders\shaders.complete">
		<Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\tools\Nuclei.ShaderCompiler\Nuclei.ShaderCompiler.csproj&quot; --configuration Release -- &quot;$(MSBuildProjectDirectory)\GpuFullSlimeSolverEngine.cs&quot; &quot;$(MSBuildProjectDirectory)\GpuDensityFieldD3DRenderer.cs&quot; &quot;$(IntermediateOutputPath)GpuShaders&quot;" />
	</Target>

	<PropertyGroup Condition="$(Configuration) == 'Debug'">
		<StartAction>Program</StartAction>
		<StartProgram>C:\Program Files\Rhino 8\System\Rhino.exe</StartProgram>
	</PropertyGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipGrasshopperInstall)' != 'true'">
		<ItemGroup>
			<GrasshopperLibraryFiles Include="$(TargetPath)" />
			<GrasshopperLibraryFiles Include="$(TargetDir)$(TargetName).deps.json" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
			<GrasshopperLibraryFiles Include="$(TargetDir)Microsoft.Bcl.HashCode.dll" Condition="Exists('$(TargetDir)Microsoft.Bcl.HashCode.dll')" />
			<GrasshopperLibraryFiles Include="$(TargetDir)Vortice.*.dll" />
			<GrasshopperLibraryFiles Include="$(TargetDir)SharpGen.Runtime.COM.dll" Condition="Exists('$(TargetDir)SharpGen.Runtime.COM.dll')" />
			<GrasshopperLibraryFiles Include="$(TargetDir)SharpGen.Runtime.dll" Condition="Exists('$(TargetDir)SharpGen.Runtime.dll')" />
			<GrasshopperLibraryFiles Include="$(TargetDir)System.Buffers.dll" Condition="Exists('$(TargetDir)System.Buffers.dll')" />
			<GrasshopperLibraryFiles Include="$(TargetDir)System.Memory.dll" Condition="Exists('$(TargetDir)System.Memory.dll')" />
			<GrasshopperLibraryFiles Include="$(TargetDir)System.Numerics.Vectors.dll" Condition="Exists('$(TargetDir)System.Numerics.Vectors.dll')" />
			<GrasshopperLibraryFiles Include="$(TargetDir)System.Resources.Extensions.dll" Condition="Exists('$(TargetDir)System.Resources.Extensions.dll')" />
			<GrasshopperLibraryFiles Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll" Condition="Exists('$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll')" />
		</ItemGroup>

		<Copy SourceFiles="@(GrasshopperLibraryFiles)" DestinationFolder="$(AppData)\Grasshopper\Libraries" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
	</Target>
</Project>
