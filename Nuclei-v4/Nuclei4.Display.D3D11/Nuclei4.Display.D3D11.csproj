<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net7.0-windows</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Nuclei4.Display.D3D11</AssemblyName>
    <RootNamespace>Nuclei4</RootNamespace>
    <ShaderCompilerProject>$(MSBuildProjectDirectory)\..\tools\Nuclei.ShaderCompiler\Nuclei.ShaderCompiler.csproj</ShaderCompilerProject>
    <DensityShaderSource>$(MSBuildProjectDirectory)\GpuDensityFieldD3DRenderer.cs</DensityShaderSource>
    <GpuSolverShaderSource Condition="Exists('$(MSBuildProjectDirectory)\..\Nuclei4.Gpu.D3D11\GpuFullSlimeSolverEngine.cs')">$(MSBuildProjectDirectory)\..\Nuclei4.Gpu.D3D11\GpuFullSlimeSolverEngine.cs</GpuSolverShaderSource>
    <GpuSolverShaderSource Condition="'$(GpuSolverShaderSource)' == ''">$(MSBuildProjectDirectory)\..\Nuclei4\GpuFullSlimeSolverEngine.cs</GpuSolverShaderSource>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nuclei4.Core\Nuclei4.Core.csproj" />
    <ProjectReference Include="..\Nuclei4.Display.Abstractions\Nuclei4.Display.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.0.*" />
    <PackageReference Include="Vortice.D3DCompiler" Version="2.4.1-beta" />
    <PackageReference Include="Vortice.Direct3D11" Version="2.4.1-beta" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewVS.cso" LogicalName="Nuclei4.GpuShaders.DensityPreviewVS.cso" />
    <EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewPS.cso" LogicalName="Nuclei4.GpuShaders.DensityPreviewPS.cso" />
    <EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewOccupancy.cso" LogicalName="Nuclei4.GpuShaders.DensityPreviewOccupancy.cso" />
    <EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewShadow.cso" LogicalName="Nuclei4.GpuShaders.DensityPreviewShadow.cso" />
    <EmbeddedResource Include="$(IntermediateOutputPath)GpuShaders\DensityPreviewComposite.cso" LogicalName="Nuclei4.GpuShaders.DensityPreviewComposite.cso" />
  </ItemGroup>

  <Target Name="CompileDisplayShaders" BeforeTargets="PrepareResources"
          Inputs="$(GpuSolverShaderSource);$(DensityShaderSource);$(ShaderCompilerProject);$(MSBuildProjectDirectory)\..\tools\Nuclei.ShaderCompiler\Program.cs"
          Outputs="$(IntermediateOutputPath)GpuShaders\shaders.complete">
    <Exec Command="dotnet run --project &quot;$(ShaderCompilerProject)&quot; --configuration Release -- &quot;$(GpuSolverShaderSource)&quot; &quot;$(DensityShaderSource)&quot; &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)GpuShaders&quot;" />
  </Target>
</Project>
